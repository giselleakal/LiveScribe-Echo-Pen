#!/usr/bin/env bash
# ./run — single entry point for the Echo notebook pipeline.
#
#   ./run               sync-free start: convert + serve (default)
#   ./run serve         same as above; extra args go to serve.py,
#                        e.g. ./run serve --port 8010 --host 0.0.0.0
#   ./run sync          full pen sync: build (if needed) -> download from
#                        pen via dumpscribe -> convert. Then run ./run
#                        (or ./run sync serve) to view.
#   ./run sync serve    download from the pen, convert + serve in one go
#   ./run convert       conversion only (no transcription)
#   ./run ocr           OCR pages on demand
#   ./run stt           transcribe session audio; pass --session PRS-… to
#                        limit to one recording (never run automatically)
#   ./run push          send notes to the Hermes echo-scribe webhook; pass
#                        --page ID / --session ID to send one, --force to
#                        re-send unchanged notes, --flush-only to drain the
#                        queue. Requires ECHO_SCRIBE_SECRET to be set.
#   ./run clean-pen     download the notebook, then delete it from the pen
#                        (bulk, destructive; prompts for confirmation)
#   ./run help          this message
#
# The pen only appears inside WSL after scripts/windows-connect.ps1 has
# been run in an admin PowerShell on the Windows side (usbipd attach).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

# Optional local secrets (gitignored). Never commit ./.env.
# e.g. ECHO_SCRIBE_SECRET, ECHO_UTC_OFFSET, ECHO_TZ.
if [ -f "$ROOT/.env" ]; then
    set -a
    # shellcheck disable=SC1091
    . "$ROOT/.env"
    set +a
fi

if [ -x "$ROOT/.venv/bin/python" ]; then
    PYTHON="$ROOT/.venv/bin/python"
else
    PYTHON="$(command -v python3)"
fi

usage() {
    sed -n '3,21p' "$0" | sed 's/^# \{0,1\}//'
}

convert_only() {
    # Plain conversion, no transcription: OCR and STT are on-demand only
    # (./run ocr, ./run stt, or the web UI Transcribe buttons).
    "$PYTHON" "$ROOT/src/convert.py" "$@"
}

serve() {
    echo "Converting (incremental)..."
    convert_only
    echo "Serving on http://127.0.0.1:8000 ... (Ctrl+C to stop)"
    exec "$PYTHON" "$ROOT/src/serve.py" "$@"
}

presetup() {
    # 1. Confirm the pen is attached, with the exact Livescribe IDs.
    if ! lsusb 2>/dev/null | grep -Eqi '1cfb:103[0-2]'; then
        echo "ERROR: Livescribe pen not attached to WSL (expected 1cfb:1030/1031/1032 in lsusb)." >&2
        echo "Run scripts/windows-connect.ps1 in an ADMIN PowerShell on Windows," >&2
        echo "then confirm with: lsusb" >&2
        exit 1
    fi

    # 2. Build the pen client if it is missing.
    if [ ! -x "$ROOT/vendor/dumpscribe" ]; then
        echo "Building dumpscribe..."
        "$ROOT/scripts/build-dumpscribe.sh"
    fi

    # 3. Download from the pen (needs root for raw USB access) and hand
    #    the dump back to this user.
    echo "Syncing pen (runs as root to access the USB device)..."
    local logfile
    logfile="$(mktemp)"
    # shellcheck disable=SC2024
    sudo "$ROOT/vendor/dumpscribe" "$ROOT/data" 2>&1 | tee "$logfile"
    # The pipeline exit status is dumpscribe's (pipefail), so a hard
    # failure still stops here; the "audio download ok" marker tells us
    # whether audio made it (so a later pen-clear offer is safe).
    ECHO_AUDIO_OK=0
    if grep -q '\[ECHO\] audio download ok' "$logfile"; then
        ECHO_AUDIO_OK=1
    fi
    rm -f "$logfile"
    sudo chown -R "$(id -u):$(id -g)" "$ROOT/data"
}

# Offer to clear the pen after a successful, fully-downloaded sync.
# Only when BOTH pages and audio are safe on disk (ECHO_AUDIO_OK) do we
# suggest retiring the pen; otherwise a clear could delete pen audio that
# was never backed up. Retire-only (-r) does NOT re-download: the sync
# just made a fresh backup, so it wipes the pen and leaves local data
# exactly as curated (deletions via the web UI stay deleted).
maybe_offer_clear_pen() {
    [ "${ECHO_AUDIO_OK:-0}" -eq 1 ] || { echo "Not offering pen clear (audio didn't download — pen left as-is)."; return 0; }
    while true; do
        read -r -p "Sync complete. Pen audio + pages are saved locally. Clear them from the pen to free space? [y/N] " ans
        case "$ans" in
            y|Y|yes|Yes)
                echo "Retiring pen (no re-download; local backup already safe). Ctrl+C to abort now..."
                sudo "$ROOT/vendor/dumpscribe" -r "$ROOT/data"
                sudo chown -R "$(id -u):$(id -g)" "$ROOT/data"
                echo "Pen cleared."
                break
                ;;
            n|N|no|No|"")
                echo "Leaving the pen untouched."
                break
                ;;
            *)
                echo "Please answer y or N."
                ;;
        esac
    done
}

clean_pen() {
    if [ ! -x "$ROOT/vendor/dumpscribe" ]; then
        echo "Building dumpscribe..."
        "$ROOT/scripts/build-dumpscribe.sh"
    fi
    if ! lsusb 2>/dev/null | grep -Eqi '1cfb:103[0-2]'; then
        echo "ERROR: Livescribe pen not attached to WSL (expected 1cfb:1030/1031/1032)." >&2
        exit 1
    fi
    read -r -p "Download the notebook, then DELETE it from the pen? [y/N] " ans
    case "$ans" in
        y|Y|yes|Yes) ;;
        *) echo "Aborted."; exit 1 ;;
    esac
    echo "Downloading from pen and deleting from pen (runs as root)..."
    sudo "$ROOT/vendor/dumpscribe" -c "$ROOT/data"
    sudo chown -R "$(id -u):$(id -g)" "$ROOT/data"
    convert_only
}

mode="${1:-}"
case "$mode" in
    ""|serve)
        [ $# -gt 0 ] && shift
        serve "$@"
        ;;
    convert)
        shift
        convert_only "$@"
        ;;
    ocr)
        shift
        "$PYTHON" "$ROOT/src/convert.py" --ocr "$@"
        ;;
    stt)
        shift
        "$PYTHON" "$ROOT/src/convert.py" --stt "$@"
        ;;
    push)
        shift
        "$PYTHON" "$ROOT/src/scribe.py" push "$@"
        ;;
    clean-pen)
        clean_pen
        ;;
    test)
        shift
        exec "$PYTHON" -m unittest discover -s "$ROOT/tests" -t "$ROOT" "$@"
        ;;
    sync)
        shift
        presetup
        convert_only
        maybe_offer_clear_pen
        # optional passthrough: ./run sync serve --port 9000
        if [ $# -gt 0 ] && [ "${1:-}" = "serve" ]; then
            shift
            serve "$@"
        fi
        echo "Done. Start ./run to view the notebook at http://127.0.0.1:8000"
        ;;
    help|-h|--help)
        usage
        ;;
    -*)
        serve "$@"
        ;;
    *)
        echo "Unknown command: $mode" >&2
        usage >&2
        exit 1
        ;;
esac
